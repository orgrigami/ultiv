# Copy to .env and fill in what you use. Every key is optional; features
# without their key report themselves as off. Never commit .env.

# --- Models ---
# Any provider on models.dev works: set its key under the name models.dev
# lists (https://models.dev) and its models appear in every model picker.
# A few common ones:
KENARI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# The default model for new chats, as provider/model (default kenari/deepseek-v4-1-flash
# when kenari is configured, else the first listed model).
# ULTIV_MODEL=kenari/deepseek-v4-1-flash
# Only these providers, even if other keys are set (comma list of models.dev ids).
# ULTIV_PROVIDERS=kenari,anthropic
# The catalog is fetched from models.dev and cached; revalidated daily.
# MODELS_DEV_URL=https://models.dev/api.json   (off = never fetch anything)
# MODELS_DEV_CACHE=var/models-dev.json
# MODELS_DEV_TTL_HOURS=24
# Kenari is also revalidated against the gateway's own /v1/models listing,
# which runs ahead of models.dev (new models appear, retired ones drop).
# KENARI_MODELS_URL=https://kenari.id/v1/models   (off = never fetch)
# KENARI_MODELS_CACHE=var/kenari-models.json
# KENARI_MODELS_TTL_HOURS=6
# Your own additions in models.dev format: extra models, extra providers
# (a local server: npm @ai-sdk/openai-compatible + api + env [] and list it
# in ULTIV_PROVIDERS), endpoint overrides. Read on every catalog refresh.
# MODELS_OVERLAY=var/models.local.json
# MODEL_MAX_CONCURRENCY=4
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# Jev's API root, for a proxy or another endpoint.
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- Vault ---
# A long random secret that seals vault items. Generate one with:
#   printf 'VAULT_KEY=%s\n' "$(openssl rand -hex 32)" >> .env
# Back it up outside this machine. Losing or changing it makes every saved
# item unreadable; there is no key rotation yet.
VAULT_KEY=
# Where items are stored, relative to the server's folder (default var/vault).
# VAULT_DIR=var/vault

# --- Tools and sensors ---
TINYFISH_API_KEY=
# Secret iCal feed URL for read-only calendar awareness.
CALENDAR_ICS_URL=
# SENSOR_POLL_MS=300000

# --- Email escalation (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
ESCALATION_EMAIL=

# --- Web Push (PWA notifications) ---
# Generate once with `vpr @ultiv/server#push:keys` (appends both keys here in
# .env, prints nothing). Never rotate casually: every device must re-subscribe.
# Push needs a secure origin: the HTTPS tailnet URL (or localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use; Safari requires mailto: or https:.
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_DIR=var/push

# --- Server ---
# PORT=8787
# CHORD_PORT=8787
# Unset = every interface, IPv4 + IPv6 (localhost, 127.0.0.1, [::1], LAN,
# tailnet). Set to narrow, e.g. HOST=127.0.0.1 for loopback only.
# HOST=
# HARNESS_DB=var/harness.sqlite
# AUDIT_LOG=var/audit.jsonl
# ARTIFACTS_DIR=var/artifacts
# WEBHOOK_DEBOUNCE_MS=2500
# WEBHOOK_RATE_PER_MIN=30
# MAILBOX_WAKE_DEBOUNCE_MS=8000

# --- Connectors (MCP) ---
# Where connector config lives (no secret bytes; keys stay in the vault).
# MCP_DIR=
# OAuth redirect for MCP sign-in; set to the tailnet https URL for phones.
# MCP_OAUTH_CALLBACK_URL=

# --- Web (build/dev only) ---
# Point the web app at a different API origin; leave unset in dev (Vite proxies /api).
# VITE_CHORD_URL=
# The next three are read by `vp dev` / `vp preview` from the SHELL env (Vite
# does not load this file into its own process.env).
# Host names the web dev/preview server accepts; unset = any name (MagicDNS
# short name, *.ts.net, .local, a tunnel). Comma list, leading dot = suffix:
# ALLOWED_HOSTS=.ts.net,.local
# Where /api, /hooks and /chord proxy to; default http://127.0.0.1:$PORT.
# API_URL=
